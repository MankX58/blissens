
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Better Auth (auth/auth.ts). Secreto de 32+ caracteres: openssl rand -base64 32
# FastAPI (backend/sesion.py) usa el mismo secreto para validar la cookie de sesión.
BETTER_AUTH_SECRET="MY_BETTER_AUTH_SECRET"
# URL pública del panel (Vite pasa /api/auth al servidor de auth y /api a FastAPI)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth: https://console.cloud.google.com/apis/credentials
# URI de redirección autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
