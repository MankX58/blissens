{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://CAMBIAR-blissens-auth.onrender.com/api/auth/:path*" },
    { "source": "/api/:path*", "destination": "https://CAMBIAR-blissens-api.onrender.com/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
